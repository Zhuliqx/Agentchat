# ============ 复制为 .env 并修改 ============

# ---- 应用 / Agent ----
# LOG_LEVEL=INFO              # 日志级别：DEBUG / INFO / WARNING / ERROR
# AGENT_TIMEOUT=120            # 单轮对话超时（秒）
# LLM_TIMEOUT=60               # 单次 LLM 请求超时（秒）
# LLM_MAX_RETRIES=2            # LLM 请求失败重试次数（客户端级）
# ---- 容错（超时 / 缓存 / 重试）----
# AGENT_CACHE_ENABLED=true     # 图执行/LLM 提示缓存（相同输入命中，跳过重复 LLM 调用）
# SUBAGENT_RETRIES=1           # 子 Agent 调用失败重试次数（agent_to_tool 内）

# ---- 人工确认（HITL，Human-in-the-Loop）----
# 默认 LLM 自主判定（HITL_ACTIONS=[]，类似 Claude Code/Codex）：由模型根据操作影响自主决定是否请求用户确认。
# 需要强制确认时，设 HITL_ACTIONS 非空（如 ["mcp"]）——调用前无条件中断；有开关的动作(联网/知识库/记忆)开关打开时自动豁免。
# HITL_ENABLED=true            # 总开关
# HITL_ACTIONS=[]              # 空=LLM 自主判定；非空=["search","rag","mcp","remember"] 中需强制确认的动作

# ---- 代码 Agent（受限沙箱执行 Python）----
# CODE_AGENT_ENABLED=true      # 是否启用代码执行 Agent
# CODE_EXEC_TIMEOUT=15         # 单段代码执行超时（秒），settrace 计时中断
# CODE_EXEC_MAX_OUTPUT=8000    # stdout/stderr 截断上限（字符）

# ---- Postgres（Docker Desktop 中运行）----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentchat

# ---- Milvus（Docker Desktop 中运行）----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=agent_documents
# 留空则自动拼接 http://host:port；也可填云端 uri
MILVUS_URI=

# ---- Embedding ----
# 本地模型（默认，中文友好）:
#   BAAI/bge-small-zh-v1.5 (512 维) | sentence-transformers/all-MiniLM-L6-v2 (384 维)
# 或 provider=openai + 模型名
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=512
EMBEDDING_DEVICE=cpu
# ---- 模型离线加载（HF 网络不可达时避免联网 HEAD 卡住）----
# HF_OFFLINE=true
# ---- LLM ----
# provider: openai | ollama | azure_openai | deepseek | dashscope
LLM_PROVIDER=deepseek
# LLM_MODEL=                  # 仅 ollama 使用；deepseek/dashscope/openai 走各自 *_MODEL
# LLM_LIGHT_MODEL=            # 可选：子 Agent（RAG/搜索/MCP）用轻量模型，Supervisor 用主模型
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0.3

# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat      # 或 deepseek-reasoner

# ---- DashScope（阿里通义，OpenAI 兼容）----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus          # 或 qwen-max / qwen-turbo

# ---- Tavily 联网搜索（LangChain 官方推荐）----
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# ---- 自建 MCP 服务器（stdio，一般无需修改）----
MCP_DB_SERVER_CMD=python
MCP_DB_SERVER_ARGS=scripts/db_query_server.py
MCP_TIME_SERVER_CMD=python
MCP_TIME_SERVER_ARGS=scripts/time_server.py

# ---- 外部 MCP 服务器（可选，逗号分隔 name=url）----
# EXTERNAL_MCP_SERVERS=github=http://localhost:8080/mcp,weather=http://localhost:8081/mcp

# ---- 原始文件存储 / 上传 ----
# UPLOAD_DIR=data/uploads     # 上传文档持久保存目录（相对项目根）
# MAX_UPLOAD_MB=50            # 上传文件大小上限（MB），超限返回 413

# ---- 检索参数 ----
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.35
# RAG_MAX_PER_DOC=2          # 检索去重：同一文档最多保留的块数（含相邻块合并）
# RAG_MAX_CHUNK_CHARS=1500   # 上下文压缩：传给 LLM 的单块最大字符数（超长截断）

# ---- 用户认证（JWT）----
# 生产环境务必改成强随机值；留空则使用代码内的开发默认值
# AUTH_SECRET=change-me-to-a-long-random-string
# TOKEN_EXPIRE_MINUTES=10080  # token 有效期（分钟，默认 7 天）
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ---- 混合检索（向量 + BM25 + RRF）----
HYBRID_SEARCH=true
# BM25_K1=1.5
# BM25_B=0.75
# RRF_K=60
# HYBRID_CANDIDATE_K=20
# BM25_MAX_DOCS=5000          # 文档块数超过则跳过 BM25 通道（防内存/CPU 爆炸）
# BM25_USE_JIEBA=false        # BM25 中文用 jieba 分词（需安装 jieba，专名/术语召回更好）

# ---- rerank 精排 ----
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=4
# RERANK_CANDIDATE_K=6        # 送入 rerank 的候选数上限（控制 CPU 推理量；越小检索越快，质量略降）
# RERANK_MAX_LENGTH=512       # rerank 输入文本截断字符数

# ---- 长期记忆（Store）----
# 语义检索需 Postgres 启用 pgvector（docker-compose 已用 pgvector 镜像；重建容器后生效）
MEMORY_SEMANTIC_SEARCH=true
# MEMORY_DEDUP_THRESHOLD=0.86   # remember 语义去重阈值（余弦）
