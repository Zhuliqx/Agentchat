# ============ 完整配置清单（复制为 .env 并修改）。覆盖 config.py 全部字段 ============
# 说明：每项格式 = 环境变量（大写=config 字段名自动映射）。默认值均在 app/config.py 中，
#       此文件为「字段 × 默认值 × 用途」的完整声明；机密项标注「必填」，部署时必须提供。

# ---- 应用 / Web ----
# APP_NAME=Multi-Agent Platform          # 应用名（影响标题/日志）
# LOG_LEVEL=INFO                          # DEBUG / INFO / WARNING / ERROR
# HOST=0.0.0.0                            # 服务监听地址（run.py 读取）
# PORT=8000                               # 服务监听端口（run.py 读取）
# AGENT_TIMEOUT=120                       # 单轮对话超时（秒）
# CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]   # CORS 显式白名单（勿用 "*"+credentials）

# ---- Postgres（对话历史 / 会话 / 文档元数据）----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres              # 生产必填（本件默认仅本地开发）
POSTGRES_DB=agentchat

# ---- Milvus（向量数据库）----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=agent_documents
# 留空则自动拼接 http://host:port；也可填云端 uri
MILVUS_URI=
# MILVUS_METRIC_TYPE=IP                   # IP(内积;向量已归一化=余弦,最快) / COSINE(自动归一化,更防御) / L2

# ---- Embedding 模型 ----
# 本地模型（默认，中文友好）: BAAI/bge-small-zh-v1.5 (512 维) | sentence-transformers/all-MiniLM-L6-v2 (384 维)
# 或 provider=openai + 模型名 (text-embedding-3-small 等)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=512
EMBEDDING_DEVICE=auto                    # auto(有CUDA用cuda否则cpu) | cuda | cpu

# ---- 模型离线加载（HF 网络不可达时避免联网 HEAD 卡住）----
# HF_OFFLINE=true

# ---- LLM ----
# provider: openai | ollama | deepseek | dashscope
LLM_PROVIDER=deepseek
# LLM_MODEL=                              # 仅 ollama 使用；deepseek/dashscope/openai 走各自 *_MODEL
# LLM_LIGHT_MODEL=                        # 子 Agent（RAG/搜索/MCP）用轻量模型；留空=与主模型相同
# LLM_TIMEOUT=60                          # 单次 LLM 请求超时（秒）
# LLM_MAX_RETRIES=2                       # LLM 请求失败重试次数（客户端级）

# ---- 容错（超时 / 缓存 / 重试）----
# AGENT_CACHE_ENABLED=true                # 图执行/LLM 提示缓存（相同输入命中，跳过重复 LLM 调用）
# SUBAGENT_RETRIES=1                      # 子 Agent 调用失败重试次数（agent_to_tool 内）
OPENAI_API_KEY=                           # 必填（若 LLM_PROVIDER=openai）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0.3

# ---- DeepSeek ----
DEEPSEEK_API_KEY=                         # 必填（若 LLM_PROVIDER=deepseek 或 image_vlm_provider=deepseek）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat              # 或 deepseek-reasoner

# ---- DashScope（阿里通义，OpenAI 兼容）----
DASHSCOPE_API_KEY=                        # 必填（若 LLM_PROVIDER=dashscope）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus                 # 或 qwen-max / qwen-turbo

# ---- Tavily 联网搜索（LangChain 官方推荐）----
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# ---- 自建 MCP 服务器（stdio，一般无需修改）----
MCP_DB_SERVER_CMD=python
MCP_DB_SERVER_ARGS=scripts/db_query_server.py
MCP_TIME_SERVER_CMD=python
MCP_TIME_SERVER_ARGS=scripts/time_server.py
# ---- 外部 MCP 服务器（可选，逗号分隔 name=url）----
# EXTERNAL_MCP_SERVERS={"github": "http://localhost:8080/mcp", "weather": "http://localhost:8081/mcp"}
#   结构化 JSON（推荐）；旧版逗号分隔 "name=url,..." 也兼容

# ---- 原始文件存储 / 上传 ----
# UPLOAD_DIR=data/uploads                 # 上传文档持久保存目录（相对项目根）
# MAX_UPLOAD_MB=50                        # 上传文件大小上限（MB），超限返回 413

# ---- 文档解析增强 / 图片语义描述（默认关=行为不变）----
# TABLE_EXTRACT=true                      # 提取 PDF/DOCX/HTML 表格为结构化块（保表头/列语义）
# TABLE_TO_TEXT_MODE=nl                   # 表格序列化: nl(推荐,embedding更佳) | markdown
# TABLE_MAX_ROWS_PER_CHUNK=10             # 表格分块：每块含表头 + 最多 N 行
# IMAGE_OCR_ENABLED=true                  # PDF 抽图 OCR（把图中文字抽出入库）
# IMAGE_OCR_ENGINE=rapidocr               # rapidocr(推荐,免系统依赖) | paddle | tesseract
# IMAGE_VLM_ENABLED=true                  # 对图片/图表用 VLM 生成语义描述（趋势/构图/结构逻辑）
# IMAGE_VLM_PROVIDER=deepseek             # deepseek | dashscope | openai | ollama
# IMAGE_VLM_MODEL=deepseek-v4-flash-vision-exp
# IMAGE_VLM_BASE_URL=                     # 留空按 provider 推断（deepseek/dashscope/openai 官方端点）
# IMAGE_VLM_API_KEY=                      # 留空按 provider 取对应 *_API_KEY
# IMAGE_VLM_MAX_SIZE=1280                 # 送入 VLM 前最长边缩放到此值（控 token/成本）
# IMAGE_VLM_DETAIL=low                    # low(缩放512省token) | high | original | auto

# ---- 图文双通道（需多模态 embedding 模型；默认关=行为不变）----
# 需先下载多模态模型：huggingface-cli download OFA-Sys/chinese-clip-vit-base-patch16
# IMAGE_DUAL_CHANNEL=true                 # 图片用多模态向量独立 collection 索引，检索时与文本通道融合
# IMAGE_EMBEDDING_PROVIDER=local          # local(Chinese-CLIP 等)
# IMAGE_EMBEDDING_MODEL=OFA-Sys/chinese-clip-vit-base-patch16
# IMAGE_EMBEDDING_DIM=512
# IMAGE_CHANNEL_TOP_K=6                   # 图像通道候选数
# IMAGE_CHANNEL_WEIGHT=0.4                # 图像通道融合权重（rrf 加权）
# EMBED_BATCH_SIZE=32                     # 分批嵌入批次大小（大文档防超时/显存峰值）
# MARKDOWN_STRIP_HEADERS=true             # Markdown 分块去掉正文标题（标题只存 metadata）
# DOC_LEVEL_DEDUP=false                   # 文档级去重：整篇内容与已有文档相同 → 跳过

# ---- 检索参数 ----
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.35
# RAG_MAX_PER_DOC=3                       # 检索去重：同一文档最多保留的块数（去重+相邻合并；3比2召回更高，上下文略长）
# RAG_MAX_CHUNK_CHARS=1500                # 上下文压缩：传给 LLM 的单块最大字符数（超长截断）
# RAG_MAX_TOTAL_CHARS=0                   # 0=不限制；>0 按分数降序累计截断，防超长 context
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ---- 混合检索（向量 + BM25 + RRF）----
HYBRID_SEARCH=true
# BM25_K1=1.5
# BM25_B=0.75
# BM25_USE_JIEBA=false                    # BM25 中文用 jieba 分词（需安装 jieba，专名/术语召回更好）
# RRF_K=60
# HYBRID_CANDIDATE_K=20                   # BM25 关键词通道候选数
# BM25_MAX_DOCS=5000                      # 文档块数超过则跳过 BM25 通道（防内存/CPU 爆炸）

# ---- rerank 精排 ----
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=4
# RERANK_CANDIDATE_K=6                    # 送入 rerank 的候选数上限（越小越快，质量略降）
# RERANK_MAX_LENGTH=512                   # rerank 输入文本截断字符数

# ---- 查询改写（默认关=行为不变）----
# QUERY_REWRITE_ENABLED=true              # 口语/低召回 query 先改写为检索词
# QUERY_REWRITE_MODE=rule                 # rule(去框架词+泛化并列) | llm(失败回退原句)
# QUERY_REWRITE_CACHE_SIZE=512

# ---- 自适应检索 / 意图路由 / 去重 / 预算（RAG 优化，默认关=行为不变）----
# ADAPTIVE_RETRIEVAL=true                 # 低置信 query 才触发"改写双路+放宽候选"
# CONF_TRIGGER_THRESHOLD=0.45             # 初检索最高分低于此值 → 判"可能召不全"触发自适应
# ADAPTIVE_CANDIDATE_K=9                  # 自适应时放宽的 rerank 候选数
# INTENT_ROUTING=true                     # 检索级意图路由（compare/list/chat/fact）
# DEDUP_NEAR_DUPLICATE=true               # 跨块/跨源 指纹+语义 去重（相似≥阈值仅留最高分）
# DEDUP_SIM_THRESHOLD=0.90
# ---- 检索上下文增强（默认关；A/B 验证后启用）----
# RAG_MULTI_TURN_CONTEXT=true             # 检索时把最近几轮会话历史拼进 query（多轮追问/指代消解）
# EMBED_WITH_CONTEXT=true                 # 嵌入侧给块文本加章节/文件名前缀（contextual embedding；存量需 force_reingest）
# RERANK_SECTION_CONTEXT=true             # rerank pair 文本带上章节/文件名前缀（纯增量）
# RAG_FRONT_LOAD_BEST=true                # 相关块前置：最高分块放开头、次高分放末尾（lost-in-the-middle 缓解）
# RERANK_BATCH_SIZE=4                     # rerank 批推理 batch_size（CPU 友好）
# PDF_PAGE_META=true                      # PDF 按页分块并记录 metadata["page"]（需 reingest PDF）
# ---- Prompt 注入防护 ----
# INJECTION_DETECTION_ENABLED=true        # 检测检索/外部内容中的注入指令（命中→剔除+告警/拒绝）
# INJECTION_LLM_REVIEW=false              # 规则命中后用 LLM 复核再剔除
# INJECTION_OUTPUT_FILTER=true            # 输出侧泄露检测

# ---- 长期记忆（Store）----
# 语义检索需 Postgres 启用 pgvector（docker-compose 已用 pgvector 镜像；重建容器后生效）
MEMORY_SEMANTIC_SEARCH=true
# MEMORY_DEDUP_THRESHOLD=0.86             # remember 语义去重阈值（余弦）

# ---- 人工确认（HITL，Human-in-the-Loop）----
# 默认 LLM 自主判定（HITL_ACTIONS=[]，类似 Claude Code/Codex）：由模型根据操作影响自主决定是否请求用户确认。
# 需要强制确认时，设 HITL_ACTIONS 非空（如 ["mcp"]）——调用前无条件中断；有开关的动作(联网/知识库/记忆)开关打开时自动豁免。
# HITL_ENABLED=true                       # 总开关
# HITL_ACTIONS=[]                         # 空=LLM 自主判定；非空=["search","rag","mcp","remember"] 中需强制确认的动作

# ---- 代码 Agent（受限沙箱执行 Python）----
# CODE_AGENT_ENABLED=true                 # 是否启用代码执行 Agent
# CODE_EXEC_TIMEOUT=15                    # 单段代码执行超时（秒），settrace 计时中断
# CODE_EXEC_MAX_OUTPUT=8000               # stdout/stderr 截断上限（字符）

# ---- 自主任务 Agent（第二项目）----
# TASK_AGENT_MODE=fixed|replan            # fixed=一次性计划(一期) / replan=每步动态重规划(二期,默认)
# TASK_AGENT_HITL=true                    # 节点级HITL: replan 产计划后人工确认; 依赖Postgres checkpointer, 未连库自动降级全自主
# TASK_AGENT_MAX_RETRIES=2                # 子任务失败自检后的最大重试次数
TASK_AGENT_MODE=replan

# ---- 可观测性（Langfuse，可选）----
# 自托管: docker compose -f docker-compose.langfuse.yml up -d
# 三个变量都配置后，run_agent/stream_agent 会自动上报 trace 到 Langfuse；留空则自动禁用（fail-open）。
# LANGFUSE_HOST=http://localhost:3000     # 必填（若要启用）
# LANGFUSE_PUBLIC_KEY=pk-lf-agentchat-dev
# LANGFUSE_SECRET_KEY=sk-lf-agentchat-dev

# ---- 用户认证（JWT）----
# 生产环境务必改成强随机值；留空则使用代码内的开发默认值
# AUTH_SECRET=change-me-to-a-long-random-string
# 未登录访客使用的默认用户 id（保持现有单用户体验）
# GUEST_USER_ID=default
# 管理员用户名（逗号分隔，如 "admin,zhangsan"）；命中者在用户菜单看到「管理后台」，可查看平台统计、用户列表并删除用户。留空则无人是管理员。
# ADMIN_USERNAMES=admin
